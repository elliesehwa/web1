# 이 파일을 복사해서 insta-auto/.env 로 만들고 값을 채워주세요.
# (.env 는 .gitignore 되어 커밋되지 않아요.)

# 인스타 비즈니스/크리에이터 계정의 IG User ID (숫자)
IG_USER_ID=

# Meta(페이스북) 앱에서 발급한 장기 액세스 토큰
# 필요한 권한: instagram_basic, instagram_content_publish, pages_read_engagement
IG_ACCESS_TOKEN=

# Graph API 버전 (선택, 기본 v21.0)
GRAPH_VERSION=v21.0
