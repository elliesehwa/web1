# OpenAI API 키
OPENAI_API_KEY=your_openai_api_key_here

# 데이터베이스 경로
DB_PATH=C:/Users/김연정/Documents/dev/lancedb-ollama

# 이미지 저장 경로
IMAGES_PATH=C:/Users/김연정/Documents/dev/images

# 임베딩 모델 설정
DEFAULT_EMBEDDING_MODEL=bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM 모델 설정
DEFAULT_LLM_MODEL=llava:13b
DEFAULT_TEMPERATURE=0.05
ANSWER_TEMPERATURE=0.3

# 검색 설정
DEFAULT_SEARCH_K=3
MIN_SEARCH_K=1
MAX_SEARCH_K=10

# UI 설정
MAX_IMAGES_DISPLAY=3
STREAMING_DELAY=0.03

# 테이블 이름 (우선순위 순서)
TABLE_NAME_1=tesla_manual_with_images
TABLE_NAME_2=tesla_manual_with_images_text
TABLE_NAME_3=tesla_manual_bge

# ==================== 토크나이저 학습 설정 ====================
# 파일 경로
TOKENIZER_INPUT_FILE=양_텍스트.txt
TOKENIZER_OUTPUT_FILE=my_korean_corpus.txt
TOKENIZER_SAVE_DIR=.
TOKENIZER_MODEL_NAME=korean_bert_tokenizer

# 토크나이저 옵션
TOKENIZER_CLEAN_TEXT=True
TOKENIZER_HANDLE_CHINESE_CHARS=True
TOKENIZER_STRIP_ACCENTS=True
TOKENIZER_LOWERCASE=True

# 학습 파라미터
TOKENIZER_VOCAB_SIZE=30000
TOKENIZER_MIN_FREQUENCY=2
TOKENIZER_SHOW_PROGRESS=True
TOKENIZER_LIMIT_ALPHABET=1000

# 인코딩 설정
TOKENIZER_ENCODING=utf-8
TOKENIZER_UNICODE_NORM=NFC
